---
const defaultApiUrl = import.meta.env.PROD ? '' : 'http://localhost:8081';
const apiUrl = (import.meta.env.PUBLIC_API_URL ?? defaultApiUrl).replace(/\/+$/, '');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>RunSense — AI Running Coach</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
  <style is:raw>
    :root {
      --bg: #0A0A0A; --text: #FAFAFA; --text-muted: #737373; --accent: #FF3D00;
      --surface: #0F0F0F; --border: #262626;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: "Inter Tight", Inter, system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(1.5rem, 5vw, 4rem);
      letter-spacing: -0.01em;
    }
    body::before {
      content: "RUN";
      position: fixed;
      right: -1rem;
      bottom: -2rem;
      color: rgba(250,250,250,.035);
      font-size: clamp(8rem, 28vw, 24rem);
      font-weight: 900;
      line-height: .8;
      letter-spacing: -0.06em;
      pointer-events: none;
    }
    .landing { max-width: 980px; width: 100%; }
    .kicker { color: var(--accent); font-family: "JetBrains Mono", monospace; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .18em; margin-bottom: 1rem; }
    .landing h1 { font-size: clamp(4rem, 14vw, 12rem); line-height: .78; letter-spacing: -0.06em; text-transform: uppercase; margin-bottom: 1.5rem; }
    .landing h1 span { color: var(--accent); }
    .landing p { color: var(--text-muted); font-size: clamp(1rem, 2vw, 1.35rem); line-height: 1.5; max-width: 46rem; margin-bottom: 2rem; }
    .btn {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      background: transparent;
      color: var(--accent);
      padding: .75rem 0;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 8px;
      font-family: "JetBrains Mono", monospace;
      font-weight: 700;
      font-size: .8rem;
      text-transform: uppercase;
      letter-spacing: .14em;
      transition: color .15s cubic-bezier(.25,0,0,1);
      cursor: pointer;
      border: none;
    }
    .btn:hover { color: var(--text); }
    .btn:disabled { opacity: .5; cursor: wait; }
    .error { color: var(--accent); margin-top: 1rem; font-family: "JetBrains Mono", monospace; font-size: .8rem; }
  </style>
</head>
<body>
  <div class="landing">
    <p class="kicker">Strava intelligence</p>
    <h1>Run<span>Sense</span></h1>
    <p>An AI running coach powered by your Strava data. Honest, data-backed training insights — no generic advice.</p>
    <button class="btn" id="connect-btn">Connect with Strava</button>
    <p class="error" id="error-msg"></p>
  </div>
  <script define:vars={{ apiUrl }}>
    document.getElementById('connect-btn').addEventListener('click', async function () {
      var btn = this;
      var err = document.getElementById('error-msg');
      btn.disabled = true;
      btn.textContent = 'Connecting…';
      err.textContent = '';
      try {
        var res = await fetch(apiUrl + '/api/auth/strava/url');
        if (!res.ok) throw new Error('Failed to get Strava auth URL');
        var data = await res.json();
        window.location.href = data.url;
      } catch (e) {
        btn.disabled = false;
        btn.textContent = 'Connect with Strava';
        err.textContent = 'Could not reach server. Is the backend running?';
      }
    });
  </script>
</body>
</html>
